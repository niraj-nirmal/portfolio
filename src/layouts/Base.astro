---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource/manjari/400.css';
import '@fontsource/manjari/700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  type?: string;
}
const { title, description, type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
const og = new URL(`${base}/og.png`.replace('//', '/'), Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Niraj Nirmal',
  jobTitle: 'Senior Technical Program Manager',
  worksFor: { '@type': 'Organization', name: 'Amazon' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Cambridge' },
    { '@type': 'CollegeOrUniversity', name: 'University of Kerala' },
  ],
  email: 'mailto:niraj.nirmal@outlook.com',
  url: 'https://niraj-nirmal.github.io/portfolio/',
  sameAs: [
    'https://www.linkedin.com/in/niraj-nirmal-6a202278/',
    'https://github.com/niraj-nirmal',
    'https://leetcode.com/u/NirajNirmal/',
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Niraj Nirmal — Writing" href={`${base}/rss.xml`} />
    <meta name="theme-color" content="#14100A" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="wrap">
        <a class="brand" href={`${base}/#top`}>Niraj <span>·</span> Nirmal</a>
        <nav class="primary" aria-label="Primary">
          <ul>
            <li><a href={`${base}/#about`}>About</a></li>
            <li><a href={`${base}/#work`}>Work</a></li>
            <li><a href={`${base}/#research`}>Research</a></li>
            <li><a href={`${base}/#code`}>Code</a></li>
            <li><a href={`${base}/#writing`}>Writing</a></li>
            <li><a href={`${base}/#contact`}>Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site" id="contact">
      <div class="wrap">
        <a class="mail" href="mailto:niraj.nirmal@outlook.com">niraj.nirmal@outlook.com</a>
        <div class="links">
          <a href="https://www.linkedin.com/in/niraj-nirmal-6a202278/" rel="noopener">LinkedIn</a>
          <a href="https://github.com/niraj-nirmal" rel="noopener">GitHub</a>
          <a href="https://leetcode.com/u/NirajNirmal/" rel="noopener">LeetCode</a>
          <a href={`${base}/rss.xml`}>RSS</a>
        </div>
        <div class="fine">© {new Date().getFullYear()} Niraj Nirmal · Views are my own.</div>
      </div>
    </footer>
    <script>
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => e.isIntersecting && e.target.classList.add('in')),
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
