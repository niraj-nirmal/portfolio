---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Not found — Niraj Nirmal" description="Page not found.">
  <section class="block" style="text-align:center;padding:140px 0">
    <div class="wrap">
      <div class="eyebrow">404</div>
      <h2 style="margin:16px 0 24px">This page wandered off.</h2>
      <a class="btn primary" href={`${base}/`}>Back home</a>
    </div>
  </section>
</Base>
