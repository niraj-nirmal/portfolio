---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const byYear = new Map<string, typeof posts>();
for (const p of posts) {
  const key = p.data.placeholder ? 'Coming soon' : String(p.data.date.getFullYear());
  if (!byYear.has(key)) byYear.set(key, []);
  byYear.get(key)!.push(p);
}
const dateFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Writing — Niraj Nirmal" description="Articles by Niraj Nirmal on MLOps, model evaluation and responsible AI.">
  <section class="block">
    <div class="wrap">
      <div class="sec-head"><span class="num">Archive</span><h2>Writing</h2></div>
      {[...byYear.entries()].map(([year, items]) => (
        <div>
          <div class="archive-year">{year}</div>
          {items.map((post) => (
            <div class="archive-item">
              <div>
                <h3 style="font-size:19px;margin:0">
                  {post.data.placeholder ? post.data.title : <a href={`${base}/writing/${post.id}/`} style="color:var(--cream);text-decoration:none">{post.data.title}</a>}
                </h3>
                <p style="margin:6px 0 0;color:var(--cream-soft);font-size:14.5px">{post.data.description}</p>
                <div class="chips" style="margin-top:8px">{post.data.tags.map((t) => <span>{t}</span>)}</div>
              </div>
              <div class="meta">
                {post.data.placeholder ? 'Coming soon' : dateFmt.format(post.data.date)}
                {post.data.readingTime && <><br />{post.data.readingTime}</>}
              </div>
            </div>
          ))}
        </div>
      ))}
      <p style="margin-top:40px"><a href={`${base}/`}>← Back home</a></p>
    </div>
  </section>
</Base>
